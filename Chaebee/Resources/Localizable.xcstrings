          }
        }
      }
    },
    "onboarding.passport.info.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaebee provides travel preparation guidance based on departures using a Korean passport.\n\nNationality and passport details are used only to provide accurate guidance on entry requirements, advance travel authorizations such as ESTA or eTA, and required documents."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채비는 한국 국적자가 한국 여권으로 출입국하는 여행을 기준으로 준비 사항을 안내해요.\n\n국적과 여권 정보는 국가별 입국 규정, 사전 허가(ESTA·eTA 등), 제출 서류를 정확하게 안내하기 위해서만 사용되고 있어요."
          }
        }
      }
    },
    "onboarding.passport.info.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why is this needed?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왜 필요한가요?"
          }
        }
      }
    },
